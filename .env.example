# Server configuration
PORT=3000
APP_URL="http://localhost:3000"

# PostgreSQL connection settings (optional in preview; required for PostgreSQL persistence)
PGHOST=
PGPORT=5432
PGDATABASE=baust_sams
PGUSER=
PGPASSWORD=
PGSSL=false

# Set to "false" to disable the client-side Demo Preview banner in production
VITE_ENABLE_DEMO_PREVIEW=true
